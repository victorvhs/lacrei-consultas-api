[importlinter]
root_package = pagamentos

[importlinter:contract:dominio-puro]
name = pagamentos.dominio não importa Django ou httpx
type = forbidden
source_modules = pagamentos.dominio
forbidden_modules = django, httpx, pagamentos.adaptadores

[importlinter:contract:fronteira-asaas]
name = Somente adaptadores.asaas conhece o Asaas
type = forbidden
source_modules = pagamentos.dominio, pagamentos.aplicacao, pagamentos.api
forbidden_modules = pagamentos.adaptadores.asaas

[importlinter:contract:agendamento-isolado]
name = profissionais e consultas não importam pagamentos
type = forbidden
source_modules = professionals, appointments
forbidden_modules = pagamentos
