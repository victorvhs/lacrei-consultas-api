[importlinter]
root_package = payments

[importlinter:contract:dominio-puro]
name = payments.dominio não importa Django ou httpx
type = forbidden
source_modules = payments.dominio
forbidden_modules = django, httpx, payments.adaptadores

[importlinter:contract:fronteira-asaas]
name = Somente adaptadores.asaas conhece o Asaas
type = forbidden
source_modules = payments.dominio, payments.aplicacao, payments.api
forbidden_modules = payments.adaptadores.asaas

[importlinter:contract:agendamento-isolado]
name = profissionais e consultas não importam payments
type = forbidden
source_modules = professionals, appointments
forbidden_modules = payments
